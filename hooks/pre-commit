#!/usr/bin/env bash
# Blocks commits that contain secrets. Enabled by install.sh via core.hooksPath.
set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed; refusing to commit without a secret scan." >&2
  echo "Install it (Arch: pacman -S gitleaks, macOS: brew install gitleaks)." >&2
  exit 1
fi

gitleaks git --staged --redact --no-banner
