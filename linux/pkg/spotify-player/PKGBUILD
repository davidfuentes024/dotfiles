# spotify_player from the davidfuentes024/spotify-player fork: upstream
# v0.25.1 built against rspotify-model with ramsayleung/rspotify#579, which
# fixes searches failing when Spotify sends `null` for an episode's
# `is_externally_hosted`. Drop this package (back to spotify-player-bin) once
# an upstream spotify_player release includes the fix.

pkgname=spotify-player-patched
_pkgname=spotify-player
pkgver=0.25.1
pkgrel=2
_tag="v${pkgver}-patched.1"
pkgdesc='A Spotify player in the terminal (with a fix for null episode fields)'
arch=('x86_64')
url="https://github.com/davidfuentes024/${_pkgname}"
license=('MIT')
depends=('alsa-lib' 'dbus' 'gcc-libs' 'glibc' 'openssl')
makedepends=('cargo' 'git')
# makepkg's LTO turns ring's C code into bitcode the Rust linker cannot read
options=('!lto')
provides=("${_pkgname}")
conflicts=("${_pkgname}" "${_pkgname}-bin")
source=("${_pkgname}-${_tag}.tar.gz::${url}/archive/${_tag}.tar.gz")
sha256sums=('11913b1b9d4e6b956ca84bb50f5d3a40d6ce7cafe23e403ec904721b93f18921')

prepare() {
  cd "${_pkgname}-${_tag#v}"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "${_pkgname}-${_tag#v}"
  cargo build --frozen --release --bin spotify_player
}

package() {
  cd "${_pkgname}-${_tag#v}"
  install -Dm755 target/release/spotify_player "${pkgdir}/usr/bin/spotify_player"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
