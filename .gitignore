# WezTerm background image: personal/heavy, not tracked.
# wezterm.lua falls back to the theme color when it is missing.
shared/wezterm/*.jpg
shared/wezterm/*.jpeg
shared/wezterm/*.png

# tmux plugins (tpm clones them with prefix + I)
shared/tmux/plugins/

# Secrets and machine-local overrides: never commit
shared/zsh/secrets.zsh
*.env
.env*
*secret*
*.local.*
*.pem
*.key
id_rsa*
id_ed25519*

# makepkg build output for local packages (linux/pkg/*)
linux/pkg/*/src/
linux/pkg/*/pkg/
linux/pkg/*/*.tar.gz
linux/pkg/*/*.pkg.tar.zst

# Backups left by install scripts
*.bak

# macOS
.DS_Store
