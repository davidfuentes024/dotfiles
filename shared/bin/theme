#!/usr/bin/env bash
# Switch the color theme of the whole setup, live.
#
#   theme                 show the current theme and black
#   theme list            list available themes
#   theme <name>          switch theme (neon, dragon, tunnel, mono)
#   theme black <variant> switch the shared black (soft, deep; used by palettes without their own bg)
#   theme font            list fonts
#   theme font <name>     switch the global font (terminal, bar, lock screen, GTK)
#   theme check [--md] [name]  WCAG AAA contrast report (all palettes, or one)
#   theme apply           regenerate everything from the saved choice
#
# The choice is saved in ~/.local/state/theme/{name,black,font}. WezTerm, nvim and
# Hyprland and Quickshell read it directly; the rest get generated files from here.
# Written for bash 3.2 so it also runs on macOS.
set -euo pipefail

THEMES_DIR="$HOME/.config/themes"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/theme"
DEFAULT_NAME="neon"
DEFAULT_BLACK="soft"
DEFAULT_FONT="jetbrains"

die() { echo "theme: $*" >&2; exit 1; }

current_name()  { cat "$STATE_DIR/name"  2>/dev/null || echo "$DEFAULT_NAME"; }
current_black() { cat "$STATE_DIR/black" 2>/dev/null || echo "$DEFAULT_BLACK"; }
current_font()  { cat "$STATE_DIR/font"  2>/dev/null || echo "$DEFAULT_FONT"; }

# value <file> <key>: read `key = "value"` from a theme file
value() {
  sed -n "s/^$2 *= *\"\(.*\)\"/\1/p" "$1" | head -n 1
}

# Loads every color of the active palette and black as shell variables
load_colors() {
  local palette="$THEMES_DIR/palettes/$(current_name).toml"
  local black="$THEMES_DIR/blacks/$(current_black).toml"
  [ -f "$palette" ] || die "unknown theme: $(current_name)"
  [ -f "$black" ]   || die "unknown black: $(current_black)"

  local key
  # Background shades: the palette's own if it defines them, else the shared black
  for key in bg bg_alt surface overlay; do
    eval "$key=\$(value \"\$palette\" $key)"
    eval "[ -n \"\$$key\" ] || $key=\$(value \"\$black\" $key)"
  done
  for key in fg fg_dim line accent accent_alt red green yellow blue magenta cyan; do
    eval "$key=\$(value \"\$palette\" $key)"
  done

  local font_file="$THEMES_DIR/fonts/$(current_font).toml"
  [ -f "$font_file" ] || die "unknown font: $(current_font)"
  font=$(value "$font_file" family)
}

# hex without the leading #
bare() { echo "${1#\#}"; }

generate_starship() {
  local template="$HOME/.config/starship.toml"
  [ -f "$template" ] || return 0
  # Drop the template's [palettes.current] block and append the active one
  awk '/^\[palettes\.current\]/ { skip = 1; next } /^\[/ { skip = 0 } !skip' "$template" \
    > "$STATE_DIR/starship.toml"
  cat >> "$STATE_DIR/starship.toml" <<EOF

[palettes.current]
base = "$bg"
surface = "$surface"
text = "$fg"
accent = "$accent"
success = "$green"
warning = "$accent_alt"
error = "$red"
muted = "$fg_dim"
EOF
}

generate_tmux() {
  cat > "$STATE_DIR/tmux.conf" <<EOF
# Generated by shared/bin/theme
set -g status-style bg=default,fg="$fg"
set -g status-left "#{?client_prefix,#[bg=$accent_alt]#[fg=$bg]#[bold] 󰌌 PREFIX ,#[bg=$accent]#[fg=$bg]#[bold] 󰆍 #S }#[bg=default,fg=default] "
set-window-option -g window-status-format "#[bg=$surface,fg=$fg_dim] #I 󰁕 #W "
set-window-option -g window-status-current-format "#[bg=$accent,fg=$bg,bold] #I 󰁔 #W "
set -g pane-border-style "fg=$line"
set -g pane-active-border-style "fg=$accent"
set -g status-right "#[bg=$surface,fg=$fg_dim]  #(basename #{pane_current_path}) #[bg=$surface,fg=$fg] 󱎫 %H:%M #[bg=default] "
EOF
  if command -v tmux >/dev/null && tmux info >/dev/null 2>&1; then
    tmux source-file "$STATE_DIR/tmux.conf" 2>/dev/null || true
  fi
}

# spotify_player reads ~/.config/spotify-player/theme.toml at start
generate_spotify_player() {
  local dir="$HOME/.config/spotify-player"
  [ -d "$dir" ] || return 0
  cat > "$dir/theme.toml" <<EOF
# Generated by shared/bin/theme
[[themes]]
name = "dotfiles"

[themes.palette]
background = "$bg"
foreground = "$fg"
black = "$surface"
red = "$red"
green = "$green"
yellow = "$yellow"
blue = "$blue"
magenta = "$magenta"
cyan = "$cyan"
white = "$fg"
bright_black = "$fg_dim"
bright_red = "$red"
bright_green = "$green"
bright_yellow = "$yellow"
bright_blue = "$blue"
bright_magenta = "$magenta"
bright_cyan = "$cyan"
bright_white = "$fg"

[themes.component_style]
block_title = { fg = "$accent", modifiers = ["Bold"] }
border = { fg = "$overlay" }
playback_track = { fg = "$fg", modifiers = ["Bold"] }
playback_artists = { fg = "$fg_dim" }
playback_album = { fg = "$fg_dim" }
playback_progress_bar = { fg = "$accent", bg = "$surface" }
playback_progress_bar_unfilled = { fg = "$surface" }
current_playing = { fg = "$accent", modifiers = ["Bold"] }
page_desc = { fg = "$accent", modifiers = ["Bold"] }
table_header = { fg = "$fg_dim" }
selection = { bg = "$surface", modifiers = ["Bold"] }
secondary_row = { bg = "$bg_alt" }
like = { fg = "$red" }
lyrics_played = { fg = "$fg_dim" }
lyrics_playing = { fg = "$accent", modifiers = ["Bold"] }
EOF
}

generate_hyprlock() {
  cat > "$STATE_DIR/hyprlock.conf" <<EOF
# Generated by shared/bin/theme
\$bg = rgb($(bare "$bg"))
\$fg = rgb($(bare "$fg"))
\$accent = rgb($(bare "$accent"))
\$accent_alt = rgb($(bare "$accent_alt"))
\$red = rgb($(bare "$red"))
\$font = $font
EOF
}

generate_gtk() {
  local css
  css=$(cat <<EOF
/* Generated by shared/bin/theme */
@define-color accent_color $accent;
@define-color accent_bg_color $accent;
@define-color accent_fg_color $bg;
@define-color window_bg_color $bg;
@define-color window_fg_color $fg;
@define-color view_bg_color $bg;
@define-color view_fg_color $fg;
@define-color headerbar_bg_color $bg_alt;
@define-color headerbar_fg_color $fg;
@define-color sidebar_bg_color $bg_alt;
@define-color card_bg_color $surface;
@define-color popover_bg_color $bg_alt;
@define-color dialog_bg_color $bg_alt;
@define-color theme_bg_color $bg;
@define-color theme_fg_color $fg;
@define-color theme_base_color $bg;
@define-color theme_text_color $fg;
@define-color theme_selected_bg_color $accent;
@define-color theme_selected_fg_color $bg;
EOF
)
  mkdir -p "$HOME/.config/gtk-3.0" "$HOME/.config/gtk-4.0"
  echo "$css" > "$HOME/.config/gtk-3.0/gtk.css"
  echo "$css" > "$HOME/.config/gtk-4.0/gtk.css"
  if command -v gsettings >/dev/null; then
    gsettings set org.gnome.desktop.interface color-scheme prefer-dark 2>/dev/null || true
    gsettings set org.gnome.desktop.interface gtk-theme Adwaita-dark 2>/dev/null || true
    gsettings set org.gnome.desktop.interface font-name "$font 10" 2>/dev/null || true
    gsettings set org.gnome.desktop.interface monospace-font-name "$font 10" 2>/dev/null || true
  fi
}

reload_nvim() {
  local socket
  # Default server sockets on Linux ($XDG_RUNTIME_DIR) and macOS ($TMPDIR)
  for socket in "${XDG_RUNTIME_DIR:-/nonexistent}"/nvim.*.0 "${TMPDIR:-/tmp}"/nvim.*/*/nvim.*.0; do
    [ -S "$socket" ] || continue
    # A hung nvim must not block the switch; it catches up on FocusGained
    if command -v timeout >/dev/null; then
      timeout 2 nvim --server "$socket" --remote-expr 'v:lua.require("core.theme").apply()' >/dev/null 2>&1 || true
    else
      nvim --server "$socket" --remote-expr 'v:lua.require("core.theme").apply()' >/dev/null 2>&1 || true
    fi
  done
}

apply() {
  mkdir -p "$STATE_DIR"
  load_colors
  generate_starship
  generate_tmux
  reload_nvim
  # WezTerm reloads by itself: it watches the state files
  if [ "$(uname -s)" = "Linux" ]; then
    generate_spotify_player
    generate_hyprlock
    generate_gtk
    if command -v hyprctl >/dev/null && [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
      hyprctl reload >/dev/null
    fi
  fi
}

# check [--md] [name]: WCAG contrast report for one palette, or all of them
#   text (fg 14:1, the rest 7:1), selection and tab text 7:1,
#   separator line and cursor 3:1 (non-text UI, AAA)
check() {
  local md=0 only="" file name
  for arg in "$@"; do
    if [ "$arg" = "--md" ]; then md=1; else only="$arg"; fi
  done
  for file in "$THEMES_DIR"/palettes/*.toml; do
    name=$(basename "$file" .toml)
    [ -z "$only" ] || [ "$only" = "$name" ] || continue
    awk -v name="$name" -v md="$md" '
      function hexv(s,   i, n, c) {
        n = 0
        for (i = 1; i <= length(s); i++) { c = index("0123456789abcdef", substr(s, i, 1)) - 1; n = n * 16 + c }
        return n
      }
      function lin(v) { v = v / 255; return v <= 0.03928 ? v / 12.92 : exp(2.4 * log((v + 0.055) / 1.055)) }
      function lum(h) { return 0.2126 * lin(hexv(substr(h, 2, 2))) + 0.7152 * lin(hexv(substr(h, 4, 2))) + 0.0722 * lin(hexv(substr(h, 6, 2))) }
      function cr(a, b,   x, y) { x = lum(a); y = lum(b); return x > y ? (x + 0.05) / (y + 0.05) : (y + 0.05) / (x + 0.05) }
      function row(label, ratio, target) {
        total++
        ok = ratio + 0.0005 >= target
        if (ok) passed++; else failed = failed " " label
        if (md) printf "| %s | %.1f | %s | %s |\n", label, ratio, target ":1", ok ? "pass" : "**FAIL**"
      }
      FNR == 1 { file++ }
      /^[a-z_]+ *= *"#[0-9a-fA-F]+"/ {
        k = $1
        match($0, /#[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]/)
        # the palette (second file) overrides the shared black (first file)
        c[k] = tolower(substr($0, RSTART, RLENGTH))
      }
      END {
        if (md) { printf "### %s\n\n| Check | Ratio | Target | Result |\n|---|---|---|---|\n", name }
        nb = split("bg bg_alt surface", bgs, " ")
        nt = split("fg fg_dim accent accent_alt red green yellow blue magenta cyan bright_red bright_green bright_yellow bright_blue bright_magenta bright_cyan", txt, " ")
        for (i = 1; i <= nt; i++) {
          if (!(txt[i] in c)) continue
          m = 99
          for (j = 1; j <= nb; j++) { r = cr(c[txt[i]], c[bgs[j]]); if (r < m) m = r }
          row(txt[i] " on backgrounds", m, txt[i] == "fg" ? 14 : 7)
        }
        row("fg on selection (overlay)", cr(c["fg"], c["overlay"]), 7)
        row("bg on accent (active tab)", cr(c["bg"], c["accent"]), 7)
        row("bg on accent_alt (prefix)", cr(c["bg"], c["accent_alt"]), 7)
        ln = ("line" in c) ? c["line"] : c["overlay"]
        row("separator line on bg", cr(ln, c["bg"]), 3)
        row("cursor (accent) on bg", cr(c["accent"], c["bg"]), 3)
        if (md) printf "\n"
        else printf "%-10s %2d/%2d pass%s\n", name, passed, total, failed ? "   FAIL:" failed : ""
      }
    ' "$THEMES_DIR/blacks/soft.toml" "$file"
  done
}

# list <dir> <current>: names in a theme subdirectory, marking the active one
list() {
  local file name
  for file in "$THEMES_DIR/$1"/*.toml; do
    name=$(basename "$file" .toml)
    if [ "$name" = "$2" ]; then echo "* $name"; else echo "  $name"; fi
  done
}

# Warns when a font is configured but not installed on this machine
check_font_installed() {
  command -v fc-list >/dev/null || return 0
  fc-list : family | grep -qF "$1" || echo "theme: warning: font \"$1\" is not installed" >&2
}

main() {
  [ -d "$THEMES_DIR" ] || die "$THEMES_DIR not found; run install.sh"
  case "${1:-}" in
    "")
      echo "theme: $(current_name)  black: $(current_black)  font: $(current_font)"
      ;;
    list)
      list palettes "$(current_name)"
      ;;
    font)
      if [ -z "${2:-}" ]; then
        list fonts "$(current_font)"
        return
      fi
      [ -f "$THEMES_DIR/fonts/$2.toml" ] || die "unknown font: $2 (try: theme font)"
      check_font_installed "$(value "$THEMES_DIR/fonts/$2.toml" family)"
      mkdir -p "$STATE_DIR"
      echo "$2" > "$STATE_DIR/font"
      apply
      echo "font: $2"
      ;;
    apply)
      apply
      ;;
    check)
      shift
      check "$@"
      ;;
    black)
      [ -n "${2:-}" ] || die "usage: theme black <soft|deep>"
      [ -f "$THEMES_DIR/blacks/$2.toml" ] || die "unknown black: $2"
      mkdir -p "$STATE_DIR"
      echo "$2" > "$STATE_DIR/black"
      apply
      echo "black: $2"
      ;;
    *)
      [ -f "$THEMES_DIR/palettes/$1.toml" ] || die "unknown theme: $1 (try: theme list)"
      mkdir -p "$STATE_DIR"
      echo "$1" > "$STATE_DIR/name"
      apply
      echo "theme: $1"
      ;;
  esac
}

main "$@"
